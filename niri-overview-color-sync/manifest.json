{
  "id": "niri-overview-color-sync",
  "name": "Niri Overview Color Sync",
  "version": "1.0.1",
  "minNoctaliaVersion": "4.6.6",
  "author": "NoFilterA1",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Keeps niri's Overview backdrop color in sync with the active Noctalia palette.",
  "tags": [
    "Theming",
    "Niri"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "enabled": true,
      "targetFile": "~/.config/niri/overview-color-sync.kdl"
    }
  }
}
